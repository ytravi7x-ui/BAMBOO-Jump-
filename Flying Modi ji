  }, 1000);
}

function executeSpin() {
  isSpinning = true;
  spinData.count--;
  localStorage.setItem("modi_jump_spins", JSON.stringify(spinData));
  drawWheel(currentAngle);

  const winIndex = Math.floor(Math.random() * numSlots);
  const extraRotations = 6;
  const targetAngle = currentAngle + (Math.PI * 2 * extraRotations) + ((numSlots - winIndex) * arcSize) - (arcSize / 2);

  let startTime = null;
  const duration = 3800;

  function animateSpin(timestamp) {
    if (!startTime) startTime = timestamp;
    const elapsed = timestamp - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const easeProgress = 1 - Math.pow(1 - progress, 3);
    const angle = currentAngle + (targetAngle - currentAngle) * easeProgress;

    drawWheel(angle);

    if (progress < 1) {
      requestAnimationFrame(animateSpin);
    } else {
      currentAngle = targetAngle % (Math.PI * 2);
      isSpinning = false;
      const reward = SLOTS[winIndex];

      if (reward.type === "coin") {
        saveData.totalCoins += reward.val;
        playCoinClink();
        showToast(`🎉 You won ${reward.val} Coins! Added to Store.`);
      } else if (reward.type === "life") {
        saveData.extraLives = (saveData.extraLives || 0) + 1;
        playCoinClink();
        showToast("💖 Extra Heart Life Won! Applied in your next game.");
      } else if (reward.type === "shield") {
        saveData.shieldActive = true;
        playCoinClink();
        showToast("🛡️ Golden Shield Won! 1 crash immunity in your next game.");
      }

      saveGameProgress();
    }
  }

  requestAnimationFrame(animateSpin);
}


<style>
* { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
body, html { width: 100%; height: 100%; overflow: hidden; background: #05080f; touch-action: manipulation; font-family: 'Poppins', sans-serif; color: #fff; }

/* Screens Layout */
.screen { position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: space-between; padding: 18px; z-index: 10; background: radial-gradient(100% 100% at 50% 0%, #162032 0%, #0f172a 100%); }
.screen.active { display: flex; }

/* Top Bars & Glass Elements */
.top-bar { width: 100%; max-width: 440px; padding: 12px 16px; text-align: center; font-family: 'Outfit', sans-serif; font-size: 18px; font-weight: 900; background: rgba(255, 255, 255, 0.06); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.1); display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
.glass-pill { padding: 6px 12px; border-radius: 99px; background: rgba(0, 242, 254, 0.12); border: 1px solid rgba(0, 242, 254, 0.3); font-size: 12px; font-weight: 800; color: #00f2fe; display: flex; align-items: center; gap: 5px; }
.coin-pill { background: rgba(241, 196, 15, 0.15); border-color: rgba(241, 196, 15, 0.3); color: #f1c40f; }

/* Main Card Containers */
.card-box { width: 100%; max-width: 440px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)); border-radius: 28px; padding: 20px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); box-shadow: 0 20px 60px rgba(0,0,0,0.5); overflow-y: auto; max-height: calc(100vh - 170px); }

/* Buttons */
.btn-container { width: 100%; max-width: 440px; display: flex; flex-direction: column; gap: 10px; }
.game-btn { width: 100%; padding: 15px; background: linear-gradient(180deg, #ffc93c, #f39c12 60%, #e67e22); border: none; border-radius: 16px; color: #fff; font-size: 15px; font-weight: 900; cursor: pointer; box-shadow: 0 4px 0 #a35d14; transition: transform 0.1s, filter 0.2s; font-family: 'Outfit', sans-serif; letter-spacing: 0.5px; text-shadow: 0 2px 4px rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; gap: 8px; }
.game-btn:active { transform: translateY(4px); box-shadow: 0 0 0 #a35d14; }
.game-btn.secondary { background: linear-gradient(180deg, #00f2fe, #4facfe); box-shadow: 0 4px 0 #008eb0; }
.game-btn.purple { background: linear-gradient(180deg, #a855f7, #6366f1); box-shadow: 0 4px 0 #4338ca; }
.game-btn:disabled { background: #475569 !important; box-shadow: 0 4px 0 #1e293b !important; opacity: 0.6; cursor: not-allowed; }
.back-btn { width: 100%; padding: 12px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 16px; color: #fff; font-weight: 800; cursor: pointer; backdrop-filter: blur(10px); }

/* Avatar Preview in Menu */
.avatar-preview { width: 124px; height: 124px; border-radius: 50%; margin: 14px auto; border: 4px solid #00f2fe; box-shadow: 0 0 30px rgba(0,242,254,0.5); overflow: hidden; background: rgba(0,0,0,0.4); position: relative; animation: floatAnim 2.2s ease-in-out infinite; }
.avatar-preview img { width: 100%; height: 100%; object-fit: cover; }

/* Level Selection Grid */
.level-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 10px; }
.level-card { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 18px; padding: 14px 8px; text-align: center; position: relative; cursor: pointer; backdrop-filter: blur(10px); transition: transform 0.1s; }
.level-card:active { transform: scale(0.96); }
.level-card.locked { opacity: 0.38; cursor: not-allowed; }
.level-card .lvl-num { font-family: 'Outfit', sans-serif; font-size: 20px; font-weight: 900; }
.level-card .lvl-target { font-size: 10px; color: #cbd5e1; margin-top: 2px; }
.level-card .lvl-high { font-size: 10px; color: #00f2fe; font-weight: 700; margin-top: 2px; }
.level-card .lvl-badge { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; background: #22c55e; border-radius: 50%; font-size: 11px; font-weight: 900; display: flex; align-items: center; justify-content: center; }

/* Store Grid */
.store-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
.skin-card { background: rgba(255, 255, 255, 0.05); border-radius: 18px; border: 1px solid rgba(255, 255, 255, 0.1); padding: 12px; display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative; text-align: center; }
.skin-card.equipped { border-color: #00f2fe; background: rgba(0, 242, 254, 0.1); box-shadow: 0 0 18px rgba(0,242,254,0.25); }
.skin-img { width: 78px; height: 78px; border-radius: 16px; object-fit: cover; background: rgba(0,0,0,0.35); border: 2px solid rgba(255,255,255,0.15); }
.skin-title { font-size: 13px; font-weight: 800; font-family: 'Outfit', sans-serif; }
.skin-desc { font-size: 9px; color: #94a3b8; font-style: italic; line-height: 1.2; height: 22px; overflow: hidden; }
.skin-price { font-size: 11px; font-weight: 800; color: #f1c40f; display: flex; align-items: center; gap: 3px; }

/* Lucky Spin Wheel */
.wheel-wrapper { position: relative; width: 260px; height: 260px; margin: 12px auto; display: flex; justify-content: center; align-items: center; }
#wheelCanvas { width: 100%; height: 100%; border-radius: 50%; border: 4px solid #00f2fe; box-shadow: 0 0 30px rgba(0,242,254,0.4); }
.pointer { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 26px solid #ff4757; z-index: 10; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.7)); }
.center-cap { position: absolute; width: 44px; height: 44px; background: radial-gradient(circle, #f39c12, #d35400); border-radius: 50%; border: 3px solid #fff; z-index: 5; display: flex; justify-content: center; align-items: center; font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 11px; box-shadow: 0 4px 15px rgba(0,0,0,0.6); color: #fff; }

/* In-Game HUD & Viewport */
#gameScreen { display: none; position: fixed; inset: 0; background: #05080f; justify-content: center; align-items: center; z-index: 100; }
#game-container { position: relative; width: 100%; max-width: 440px; height: 100dvh; max-height: 840px; background: #0b1329; overflow: hidden; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
canvas#gameCanvas { display: block; width: 100%; height: 100%; cursor: pointer; }

#ui-layer { position: absolute; inset: 0; pointer-events: none; display: flex; flex-direction: column; align-items: center; z-index: 15; }
.top-hud { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 12px 14px 0; pointer-events: auto; }
.hud-glass { backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(15, 23, 42, 0.65); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 16px; padding: 6px 12px; color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; gap: 5px; }

.hud-progress-wrap { width: 75%; margin-top: 8px; background: rgba(0,0,0,0.6); padding: 3px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.2); }
.hud-progress-fill { height: 8px; width: 0%; background: linear-gradient(90deg, #22c55e, #00f2fe, #a855f7); border-radius: 10px; transition: width 0.2s ease; }

#score-board { font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 900; color: #fff; margin-top: 4px; text-shadow: 0 0 15px rgba(0,242,254,0.8); transition: transform 0.1s ease; }
#score-board.pop { transform: scale(1.22); }

/* Overlays / Modals */
.glass-box { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); padding: 24px; border-radius: 28px; width: 85%; max-width: 330px; text-align: center; pointer-events: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.6); color: #0f172a; }
.modal-stat-box { margin: 12px 0; padding: 10px 14px; background: #f1f5f9; border-radius: 16px; font-size: 13px; font-weight: 700; color: #334155; }
.modal-stat-row { display: flex; justify-content: space-between; align-items: center; margin: 4px 0; }

.modal { display: none; position: fixed; inset: 0; background: rgba(5, 8, 15, 0.92); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); z-index: 999; justify-content: center; align-items: center; flex-direction: column; padding: 20px; text-align: center; }

/* Ad Containers */
.ad-banner-slot { width: 100%; max-width: 440px; margin: 8px 0; display: flex; justify-content: center; align-items: center; min-height: 50px; background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15); border-radius: 12px; font-size: 10px; color: #94a3b8; }

/* Toast Notification */
#toast-notification { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(0, 242, 254, 0.5); color: #e0f2fe; padding: 10px 22px; border-radius: 99px; font-size: 12px; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,0.6); display: none; }

@keyframes floatAnim { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@keyframes completePop { 0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
.pop-anim { animation: completePop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
</style>
</head>

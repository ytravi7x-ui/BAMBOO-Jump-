// Particle Pool
class ParticlePool {
  constructor(max = 120) {
    this.pool = []; this.active = [];
    for (let i = 0; i < max; i++) {
      this.pool.push({ x: 0, y: 0, vx: 0, vy: 0, life: 0, max: 0, size: 0, color: '#fff', alpha: 1 });
    }
  }
  spawn(x, y, o) {
    if (!this.pool.length) return;
    const p = this.pool.pop();
    Object.assign(p, {
      x, y, vx: o.vx || 0, vy: o.vy || 0,
      life: o.life || 1, max: o.life || 1,
      size: o.size || 3, color: o.color || "#fff", alpha: 1
    });
    this.active.push(p);
  }
  update(dt) {
    for (let i = this.active.length - 1; i >= 0; i--) {
      const p = this.active[i];
      p.x += p.vx * dt * 60; p.y += p.vy * dt * 60;
      p.vy += 0.14 * dt * 60; p.life -= dt;
      p.alpha = Math.max(0, p.life / p.max);
      if (p.life < 0) this.pool.push(this.active.splice(i, 1)[0]);
    }
  }
  draw() {
    for (const p of this.active) {
      ctx.save(); ctx.globalAlpha = p.alpha; ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
    }
  }
}
const particles = new ParticlePool();

// Weather Cycle
class BackgroundSystem {
  constructor() {
    this.timer = 0;
    this.stateIndex = 0;
    this.states = ["DAY", "EVENING", "NIGHT", "RAIN"];
    this.durationPerState = 14;
    this.rainDrops = Array.from({ length: 70 }, () => ({
      x: Math.random() * (CW + 100) - 50,
      y: Math.random() * CH,
      l: 12 + Math.random() * 18,
      speed: 12 + Math.random() * 10,
      op: 0.3 + Math.random() * 0.5
    }));
    this.rainOpacity = 0;
  }
  update(dt, isPlaying) {
    if (isPlaying) {
      this.timer += dt;
      if (this.timer > this.durationPerState) {
        this.timer = 0;
        this.stateIndex = (this.stateIndex + 1) % this.states.length;
        document.getElementById("weather-label").innerText = this.states[this.stateIndex];
      }
    }
    if (this.stateIndex === 3) {
      this.rainOpacity = Math.min(1, this.rainOpacity + dt * 0.8);
    } else {
      this.rainOpacity = Math.max(0, this.rainOpacity - dt * 0.8);
    }
    if (this.rainOpacity > 0) {
      this.rainDrops.forEach(r => {
        r.y += r.speed * dt * 60; r.x -= 2.6 * dt * 60;
        if (r.y > CH) { r.y = -20; r.x = Math.random() * (CW + 100) - 50; }
      });
    }
  }
  drawCoverImage(img, alpha = 1) {
    if (!img.complete || img.naturalWidth === 0 || alpha <= 0.01) return;
    ctx.save();
    ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
    const imgRatio = img.naturalWidth / img.naturalHeight;
    const canvasRatio = CW / CH;
    let renderW, renderH, offsetX, offsetY;
    if (imgRatio > canvasRatio) {
      renderH = CH; renderW = CH * imgRatio;
      offsetX = (CW - renderW) / 2; offsetY = 0;
    } else {
      renderW = CW; renderH = CW / imgRatio;
      offsetX = 0; offsetY = (CH - renderH) / 2;
    }
    ctx.drawImage(img, offsetX, offsetY, renderW, renderH);
    ctx.restore();
  }
  draw() {
    let grad = ctx.createLinearGradient(0, 0, 0, CH);
    if (this.stateIndex === 0) {
      grad.addColorStop(0, "#08101e"); grad.addColorStop(0.5, "#101b2b"); grad.addColorStop(1, "#080c14");
    } else if (this.stateIndex === 1) {
      grad.addColorStop(0, "#190a1d"); grad.addColorStop(0.5, "#2d1222"); grad.addColorStop(1, "#0a060d");
    } else {
      grad.addColorStop(0, "#02040a"); grad.addColorStop(0.6, "#080e1a"); grad.addColorStop(1, "#020408");
    }
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, CW, CH);

    const progress = this.timer / this.durationPerState;
    if (this.stateIndex === 0) {
      this.drawCoverImage(bgDayImg, 1);
    } else if (this.stateIndex === 1) {
      this.drawCoverImage(bgDayImg, 1 - progress);
      this.drawCoverImage(bgEveImg, progress);
    } else if (this.stateIndex === 2) {
      this.drawCoverImage(bgEveImg, 1 - progress);
      this.drawCoverImage(bgNightImg, progress);
    } else if (this.stateIndex === 3) {
      this.drawCoverImage(bgNightImg, 1);
    }

    if (this.rainOpacity > 0) {
      ctx.save();
      ctx.strokeStyle = "rgba(210, 230, 255, 0.65)"; ctx.lineWidth = 1.4; ctx.lineCap = "round";
      this.rainDrops.forEach(r => {
        ctx.globalAlpha = r.op * this.rainOpacity;
        ctx.beginPath(); ctx.moveTo(r.x, r.y); ctx.lineTo(r.x - 4, r.y + r.l); ctx.stroke();
      });
      ctx.restore();
    }
  }
}
const bgSystem = new BackgroundSystem();

// Bamboo Obstacle
class BambooPipe {
  constructor(gapSize) {
    this.x = CW;
    this.y = Math.random() * (CH - gapSize - 220) + 110;
    this.gap = gapSize;
    this.passed = false;
  }
  draw() {
    this.renderPipe(this.y, true);
    this.renderPipe(CH - (this.y + this.gap), false);
  }
  renderPipe(h, isTop) {
    const pipeWidth = 76;
    let y = isTop ? 0 : this.y + this.gap;
    ctx.save();
    let g = ctx.createLinearGradient(this.x, 0, this.x + pipeWidth, 0);
    g.addColorStop(0, "#3f2a12"); g.addColorStop(0.2, "#8d6a35");
    g.addColorStop(0.5, "#f2d78e"); g.addColorStop(0.85, "#7a5a2e"); g.addColorStop(1, "#3f2a12");
    ctx.fillStyle = g;
    ctx.fillRect(this.x, y, pipeWidth, h);

    ctx.strokeStyle = "rgba(45,28,10,0.6)"; ctx.lineWidth = 2;
    for (let ry = y + 25; ry < y + h; ry += 45) {
      ctx.beginPath(); ctx.moveTo(this.x, ry); ctx.lineTo(this.x + pipeWidth, ry); ctx.stroke();
    }

    let capY = isTop ? y + h - 22 : y;
    let capG = ctx.createLinearGradient(this.x - 8, capY, this.x + pipeWidth + 8, capY + 22);
    capG.addColorStop(0, "#432108"); capG.addColorStop(0.5, "#f1d58b"); capG.addColorStop(1, "#3d2810");
    ctx.fillStyle = capG; ctx.fillRect(this.x - 8, capY, pipeWidth + 16, 22);
    ctx.strokeStyle = "#2a1c0c"; ctx.lineWidth = 2; ctx.strokeRect(this.x - 8, capY, pipeWidth + 16, 22);

    ctx.fillStyle = "#22c55e";
    ctx.beginPath(); ctx.ellipse(this.x + 2, capY + 11, 7, 3.5, 0.6, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(this.x + pipeWidth - 2, capY + 11, 7, 3.5, -0.6, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }
}


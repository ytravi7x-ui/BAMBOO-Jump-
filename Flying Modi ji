// ==================== 11. MAIN ENGINE LOOP ====================
function loop(now) {
  let dt = Math.min((now - last) / 1000, 0.033);
  last = now;
  dt *= slow;
  if (gameState === "STOPPED") dt = 0.016;

  ctx.save();
  if (shake > 0) {
    ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
    shake *= 0.88;
    if (shake < 0.4) shake = 0;
  }

  bgSystem.update(dt, gameState === "PLAYING");
  bgSystem.draw();

  if (gameState === "PLAYING") {
    pipeTimer += dt;
    if (pipeTimer > currentConfig.freq) {
      pipes.push(new BambooPipe(currentConfig.gap));
      if (Math.random() < 0.85) {
        coins.list.push({
          x: CW + 25,
          y: pipes[pipes.length - 1].y + currentConfig.gap / 2,
          ph: Math.random() * 6.28
        });
      }
      pipeTimer = 0;
    }
  }

  // Draw & Update Pipes
  for (let i = pipes.length - 1; i >= 0; i--) {
    let p = pipes[i];
    if (gameState === "PLAYING") p.x -= currentConfig.speed * dt * 60;
    p.draw();

    if (gameState === "PLAYING") {
      const hitPadding = 12;
      if (
        bird.x + bird.w - hitPadding > p.x &&
        bird.x + hitPadding < p.x + 76 &&
        (bird.y + hitPadding < p.y || bird.y + bird.h - hitPadding > p.y + p.gap)
      ) {
        if (hasShield) {
          hasShield = false;
          shake = 10; flash = 0.5;
          showToast("🛡️ Shield Absorbed the Bamboo Crash!");
          p.x = -120;
        } else {
          inGameLives--;
          document.getElementById("hud-lives-count").innerText = inGameLives;
          if (inGameLives > 0) {
            shake = 10;
            bird.y = 260;
            bird.vy = 0;
            showToast(`💔 Remaining Lives: ${inGameLives}`);
            p.x = -120;
          } else {
            triggerGameOver("Crashed into a bamboo obstacle!");
            break;
          }
        }
      }

      if (p.x + 76 < bird.x && !p.passed) {
        p.passed = true;
        score++;
        updateHUDScore();
        const sb = document.getElementById("score-board");
        sb.classList.remove("pop");
        void sb.offsetWidth;
        sb.classList.add("pop");

        if (score >= currentConfig.target) {
          triggerLevelComplete();
          break;
        }
      }
    }

    if (p.x < -100) pipes.splice(i, 1);
  }

  // Draw & Update Coins
  for (let i = coins.list.length - 1; i >= 0; i--) {
    let c = coins.list[i];
    if (gameState === "PLAYING") {
      c.x -= currentConfig.speed * dt * 60;
      c.ph += dt * 5;
    }

    ctx.save();
    ctx.translate(c.x + 13, c.y + 13);
    ctx.rotate(Math.sin(c.ph) * 0.16);

    let gg = ctx.createRadialGradient(0, 0, 2, 0, 0, 14);
    gg.addColorStop(0, "#fffde7"); gg.addColorStop(0.4, "#f1c40f"); gg.addColorStop(1, "#b45309");
    ctx.fillStyle = gg; ctx.shadowColor = "#f1c40f"; ctx.shadowBlur = 10;
    ctx.beginPath(); ctx.arc(0, 0, 13, 0, Math.PI * 2); ctx.fill();

    ctx.shadowBlur = 0; ctx.fillStyle = "#78350f"; ctx.font = "bold 13px Poppins, sans-serif";
    ctx.textAlign = "center"; ctx.textBaseline = "middle";
    ctx.fillText("₹", 0, 1);
    ctx.restore();

    // COIN COLLECTION LOGIC: Adds directly to user's wallet for Character Store!
    if (gameState === "PLAYING" && bird.x < c.x + 26 && bird.x + bird.w > c.x && bird.y < c.y + 26 && bird.y + bird.h > c.y) {
      coins.collected++;
      saveData.totalCoins++; // STORE WALLET MEIN TURANT ADD HO RAHA HAI!
      saveGameProgress();

      document.getElementById("hud-coin-count").innerText = coins.collected;
      playCoinClink(); // Clink audio on coin collect!

      for (let k = 0; k < 10; k++) {
        particles.spawn(c.x + 13, c.y + 13, {
          vx: (Math.random() - 0.5) * 5, vy: (Math.random() - 0.5) * 5,
          life: 0.55, size: 2.5 + Math.random() * 2, color: "#f1c40f"
        });
      }
      coins.list.splice(i, 1);
    } else if (c.x < -30) {
      coins.list.splice(i, 1);
    }
  }

  bird.draw();
  bird.update(dt);

  particles.update(dt);
  particles.draw();

  if (flash > 0) {
    ctx.fillStyle = `rgba(255,255,255,${flash})`;
    ctx.fillRect(0, 0, CW, CH);
    flash -= dt * 2.5;
  }

  ctx.restore();
  requestAnimationFrame(loop);
}

requestAnimationFrame(loop);
updateGlobalUI();
</script>
</body>
</html>

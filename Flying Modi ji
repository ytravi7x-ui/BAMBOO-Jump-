const numSlots = SLOTS.length;
const arcSize = (Math.PI * 2) / numSlots;

function drawWheel(angle = 0) {
  wCtx.clearRect(0, 0, 280, 280);
  wCtx.save();
  wCtx.translate(140, 140);
  wCtx.rotate(angle);

  for (let i = 0; i < numSlots; i++) {
    const startAngle = i * arcSize;
    const endAngle = (i + 1) * arcSize;

    wCtx.beginPath();
    wCtx.moveTo(0, 0);
    wCtx.arc(0, 0, 130, startAngle, endAngle);
    wCtx.closePath();
    wCtx.fillStyle = SLOTS[i].color;
    wCtx.fill();
    wCtx.strokeStyle = "rgba(255, 255, 255, 0.35)";
    wCtx.lineWidth = 2.5;
    wCtx.stroke();

    wCtx.save();
    wCtx.rotate(startAngle + arcSize / 2);
    wCtx.textAlign = "right";
    wCtx.fillStyle = "#ffffff";
    wCtx.font = "bold 11px Poppins, sans-serif";
    wCtx.shadowColor = "rgba(0, 0, 0, 0.8)";
    wCtx.shadowBlur = 4;
    wCtx.fillText(SLOTS[i].name, 118, 4);
    wCtx.restore();
  }
  wCtx.restore();

  document.getElementById("spins-left-text").innerText = `${spinData.count}/5`;
  document.getElementById("menu-spins-val").innerText = spinData.count;

  const btn = document.getElementById("spin-action-btn");
